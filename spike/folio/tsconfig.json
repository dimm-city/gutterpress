{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "spikes/**/*.ts",
    "fixtures/**/*.ts",
    "compare/**/*.ts",
    "../../packages/cli/src/markdown-shims.d.ts",
    "../../packages/cli/src/htmlhint.d.ts",
    "../../packages/cli/src/diff3-shim.d.ts"
  ]
}
