{
  "name": "@dimm-city/print-md-viewer",
  "private": true,
  "version": "0.1.0-beta.8",
  "type": "module",
  "main": "electron-dist/main.js",
  "author": "itlackey",
  "description": "Desktop viewer for print-md (Electron + SvelteKit).",
  "scripts": {
    "dev": "node ./node_modules/.bin/vite dev",
    "build": "node ./node_modules/.bin/vite build",
    "preview": "node ./node_modules/.bin/vite preview",
    "electron:build": "tsc -p electron/tsconfig.json && node -e \"require('fs').writeFileSync('electron-dist/package.json', '{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "electron:dev": "npm run electron:build && npm run build && electron electron-dist/main.js",
    "dist:linux": "npm run build && npm run electron:build && npx electron-builder --linux AppImage --config electron-builder.yml",
    "dist:win": "npm run build && npm run electron:build && npx electron-builder --win zip --config electron-builder.yml",
    "dist:mac": "npm run build && npm run electron:build && npx electron-builder --mac dmg --config electron-builder.yml",
    "check": "node ./node_modules/.bin/svelte-kit sync && node ./node_modules/.bin/svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@dimm-city/print-md-lib": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.0",
    "@sveltejs/kit": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0"
  }
}
