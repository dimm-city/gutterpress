{
  "name": "@dimm-city/vscode-markdown-editor",
  "version": "0.0.2-85.gp.1",
  "type": "module",
  "private": true,
  "license": "MIT",
  "description": "Internal Gutterpress fork of @vscode/markdown-editor@0.0.2-85 (SFE-P1b; re-pinned from 0.0.2-84, byte-identical), carrying the minimal renderCustomBlock seam and the SFE-P3f measurement patch. Not published; see NOTICE and PATCHES.md.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "typesVersions": {
    "*": {
      "config": [
        "./dist/config.d.ts"
      ],
      "commands": [
        "./dist/commands.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src/view/editor.css",
    "src/view/themes/default.css",
    "src/view/themes/github.css",
    "src/view/themes/vscode-github.css",
    "src/view/themes/vscode-default.css",
    "src/contrib/comments/commentInput.css",
    "src/contrib/comments/commentWidget.css",
    "src/contrib/find/find.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./commands": {
      "types": "./dist/commands.d.ts",
      "import": "./dist/commands.js"
    },
    "./web-editors": {
      "types": "./dist/web-editors.d.ts",
      "import": "./dist/web-editors.js"
    },
    "./editor.css": "./src/view/editor.css",
    "./themes/default.css": "./src/view/themes/default.css",
    "./themes/github.css": "./src/view/themes/github.css",
    "./themes/vscode-github.css": "./src/view/themes/vscode-github.css",
    "./themes/vscode-default.css": "./src/view/themes/vscode-default.css",
    "./commentInput.css": "./src/contrib/comments/commentInput.css",
    "./commentWidget.css": "./src/contrib/comments/commentWidget.css"
  },
  "dependencies": {
    "@vscode/codicons": "0.0.46-36",
    "@vscode/diff": "0.0.2-0",
    "@vscode/observables": "^0.1.1-0",
    "katex": "^0.16.33",
    "micromark": "^4.0.1",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.1",
    "micromark-extension-gfm-task-list-item": "^2.1.0",
    "micromark-extension-math": "^3.1.0"
  },
  "scripts": {
    "verify-vendored": "node scripts/verify-vendored.mjs"
  },
  "gutterpressFork": {
    "upstreamName": "@vscode/markdown-editor",
    "upstreamVersion": "0.0.2-85",
    "upstreamGitHead": "c04545f2b72446a3b2fd76bf9085aca5a009ad1f",
    "upstreamRepository": {
      "type": "git",
      "url": "https://github.com/microsoft/vscode-packages",
      "directory": "vscode-team-tools/packages/markdown-editor"
    },
    "vendoredFrom": {
      "tarball": "https://registry.npmjs.org/@vscode/markdown-editor/-/markdown-editor-0.0.2-85.tgz",
      "integrity": "sha512-9mtAwdyzDqrPAPDcupyu2iahyZU4V3gvzxhS5rvbThRkARJshQOiHkIhQNuO0LgkVEy2pwWoKa+AKE+qfx7xzA=="
    },
    "patches": "renderCustomBlock (SFE-P1b) + measurement (SFE-P3f) — see PATCHES.md",
    "removalTrigger": "Delete this fork when upstream ships an equivalent generic block-render hook (BlockViewOptions gaining a paragraph/unhandledBlock custom-render seam), or when the seam is upstreamed as a PR. See docs/plans/source-first-editor/runs/SFE-P1b.md."
  }
}
