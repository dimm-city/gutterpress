{
  // Isolated DOM-aware typecheck program for src/gutterpress/** +
  // tests/gutterpress/** (SFE-P2b Lane B), mirroring the EXACT precedent
  // ../web.tsconfig.json set for src/web/** — see that file's own header
  // for the full rationale (packages/editor/tsconfig.json, one directory
  // up, is deliberately DOM-free: "lib": ["ES2023"] only).
  //
  // This program exists because `provider.ts`/`render-chip.ts`/`mount.ts`
  // (this directory) build real chip DOM and, for mount.ts, call
  // `createVscodeEditorAdapter` (`../vscode-adapter/index.ts`) — both
  // genuinely need `Document`/`HTMLElement`/`Node` types. `match.ts` and
  // `plan.ts` do not (see their own headers) but are included here too so
  // one program covers the whole directory, matching web.tsconfig.json's
  // own scope.
  //
  // SHIPPED ARRANGEMENT (verified, SFE-P2b repair round 1 — a prior
  // committed comment here claimed this was still pending integrator action;
  // it was not, and had already landed in the SAME run): the root DOM-free
  // program (../../tsconfig.json) excludes both "src/gutterpress" and
  // "tests/gutterpress" (alongside "src/web", "tests/web",
  // "src/vscode-adapter", "tests/vscode-adapter", "tests/browser-harness"),
  // so it never tries to typecheck this directory — THIS program is the one
  // that owns src/gutterpress + tests/gutterpress, exactly as
  // ../web.tsconfig.json owns src/web + tests/web. `bun run typecheck`
  // (which runs all three programs in sequence — see package.json's script)
  // exits 0.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  // Paths are relative to THIS file's directory (packages/editor/src/gutterpress/).
  "include": [".", "../../tests/gutterpress"],
  "exclude": []
}
