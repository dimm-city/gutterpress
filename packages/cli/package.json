{
  "name": "gutterpress",
  "version": "0.11.0-alpha.0",
  "description": "Markdown-to-PDF converter for professional print layout using a native Chromium print engine and Ghostscript.",
  "author": "itlackey",
  "license": "MPL-2.0",
  "keywords": [
    "markdown",
    "pdf",
    "print",
    "ghostscript",
    "book",
    "publishing",
    "zine"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dimm-city/gutterpress.git"
  },
  "homepage": "https://github.com/dimm-city/gutterpress#readme",
  "bugs": {
    "url": "https://github.com/dimm-city/gutterpress/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "gutterpress": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "default": "./dist/render.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "default": "./dist/plugins.js"
    },
    "./viewer": {
      "types": "./dist/viewer.d.ts",
      "default": "./dist/viewer.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:library": "bun scripts/build-engine-bundles.mjs && rimraf dist && bun build src/index.ts src/api/index.ts src/plugins.ts --target=node --packages=external --splitting --outdir=dist && bun build src/render.ts --target=node --packages=external --outdir=dist && bun build src/viewer.ts --target=browser --packages=external --outdir=dist && node scripts/check-render-pure.mjs && tsc -p tsconfig.build.json && tsc -p src/viewer.tsconfig.json",
    "build": "bun run build:library && bun build src/cli.ts --target=node --packages=external --splitting --outdir=dist",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "typecheck:engine-browser": "tsc --noEmit -p src/engine/browser.tsconfig.json",
    "parity:gate": "bun scripts/native-parity-gate.ts"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=22.0.0"
  },
  "dependencies": {
    "acorn": "8.16.0",
    "chokidar": "^5.0.0",
    "citty": "^0.2.0",
    "diff3": "0.0.3",
    "es-module-lexer": "2.0.0",
    "fflate": "0.8.3",
    "glob": "^13.0.0",
    "htmlhint": "^1.9.2",
    "isomorphic-git": "^1.38.4",
    "markdown-it": "^14.1.0",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-attrs": "^4.3.0",
    "markdown-it-deflist": "^3.0.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-source-map": "^0.1.1",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdownlint": "^0.40.0",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.18",
    "puppeteer-core": "^25.0.4",
    "resolve.exports": "2.0.3",
    "semver": "7.8.0",
    "tar": "7.5.20",
    "unpdf": "^1.6.2",
    "ws": "^8.21.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/semver": "^7.7.1",
    "@types/ws": "^8.5.13",
    "playwright": "^1.60.0",
    "rimraf": "^6.0.0",
    "typescript": "^5"
  }
}
