{
  "name": "@dimm-city/print-md",
  "version": "0.6.0-beta.13",
  "description": "Markdown-to-PDF converter for professional print layout using Paged.js and Ghostscript.",
  "author": "itlackey",
  "license": "MPL-2.0",
  "keywords": [
    "markdown",
    "pdf",
    "print",
    "pagedjs",
    "ghostscript",
    "book",
    "publishing",
    "ttrpg"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dimm-city/print-md.git"
  },
  "homepage": "https://github.com/dimm-city/print-md#readme",
  "bugs": {
    "url": "https://github.com/dimm-city/print-md/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "print-md": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "default": "./dist/render.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rimraf dist && bun build src/index.ts src/api/index.ts src/cli.ts src/render.ts --target=node --packages=external --splitting --outdir=dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "citty": "^0.2.0",
    "diff3": "0.0.3",
    "glob": "^13.0.0",
    "htmlhint": "^1.9.2",
    "isomorphic-git": "^1.38.4",
    "markdown-it": "^14.1.0",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-attrs": "^4.3.0",
    "markdown-it-deflist": "^3.0.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-source-map": "^0.1.1",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdownlint": "^0.40.0",
    "pagedjs": "^0.4.3",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.15",
    "puppeteer-core": "^25.0.4",
    "unpdf": "^1.6.2",
    "ws": "^8.18.2",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "playwright": "^1.60.0",
    "rimraf": "^6.0.0",
    "typescript": "^5"
  }
}
