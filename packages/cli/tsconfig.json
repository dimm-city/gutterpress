{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  // Type-check the package source only — not the standalone helper scripts in
  // tools/ or the gitignored tests/ scratch dir.
  "include": ["src"],
  // The Gutterpress engine's browser-side sources (bundled to an IIFE by
  // scripts/build-engine-bundles.mjs, never imported by any Node-side file
  // here — see src/engine/browser.tsconfig.json) run against `window`/
  // `document`/etc. This program is Node-targeted (`lib: ["ESNext"]`, no DOM)
  // on purpose: TypeScript's `lib` is program-global, not scoped per file, so
  // adding DOM here would leak DOM's `Response`/`Uint8Array`/`fetch` overloads
  // into every Node file in the package (measured: it silently broke an
  // unrelated `new Response(uint8Array)` call in npm-plugin-installer.test.ts).
  // Excluded here and checked in their own isolated program instead.
  "exclude": ["src/engine/viewer", "src/engine/compiler/agent.ts"]
}
