    "pagedjs": "^0.4.3",
    "postcss": "^8.5.15",
    "puppeteer-core": "^25.0.4",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "yaml": "^2.8.2",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/markdown-it": "^14.1.2",
    "@types/ws": "^8.5.13",
    "htmlhint": "^1.1.4",
    "markdownlint-cli2": "^0.22.1"
