{
  "name": "@dimm-city/print-md-lib",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
