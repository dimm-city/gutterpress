# dependencies (bun install)
node_modules
.notes

# output
out
dist
*.tgz
# Root-level SvelteKit sync output (`svelte-kit sync` regenerates this from the
# root workspace tsconfig probe). Explicit because none of the patterns above
# match it: `out`/`dist` are unrelated names, and packages/desktop/.gitignore's
# own `.svelte-kit` entry only covers that package's directory, not this root
# one — which is why 7 files under it were tracked (see tools/check-generated-files.mjs).
/.svelte-kit

# temporary test files
.tmp/

# code coverage
coverage
*.lcov

# logs
logs
_.log
report.[0-9]_.[0-9]_.[0-9]_.[0-9]_.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# caches
.eslintcache
.cache
*.tsbuildinfo

# IntelliJ based IDEs
.idea

# Finder (MacOS) folder config
.DS_Store
.claude/*
!.claude/workflows/
dist/

# Code index and reference files (can be regenerated)
.references/
examples/field-guide/
# CLI test scratch / generated output (was previously covered by a blanket
# `tests/` ignore; keep just these specific generated paths ignored).
/packages/cli/tests/field-guide/
/packages/cli/tests/field-guide-bak/
/packages/cli/tests/field-guide-input/
/packages/cli/tests/field-guide.pdf
# (Removed a blanket `tests/` ignore: there is no root-level scratch tests dir —
# the only tests/ dirs are packages/{cli,desktop}/tests, which are all
# committed. The blanket rule matched them at any depth and, via git's
# "can't re-include under an excluded parent" rule, forced `git add -f` and
# broke negations for any NEW test file. Package test dirs are tracked normally.)
.reviews/
*.zip
*.skill
.trash/
.akm-run/
review/
review_screenshots/
_site/dc-design-guide-migration-check/
.gutterpress-stage/
web-ui-signing.key

# Playwright artifacts (cross-browser preview smoke test)
test-results/

# generated update-manifest baseline (desktop build artifact)
packages/desktop/version.json

# Local-only plan/history docs (moved out of the repo to keep assets small)
.docs-archive/
packages/cli/final-check.mjs
