{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tools/*.mjs"],
      "project": ["tools/**/*.mjs"]
    },
    "packages/cli": {
      "entry": [
        "src/cli.ts",
        "src/index.ts",
        "src/api/index.ts",
        "src/render.ts",
        "scripts/*.mjs",
        "src/**/*.test.ts",
        "src/**/*.test.js",
        "tests/**/*.test.ts"
      ],
      "project": ["src/**/*.{ts,js,mjs}", "scripts/**/*.mjs", "tests/**/*.{ts,js,mjs}"]
    },
    "packages/desktop": {
      "entry": [
        "src/routes/**/+*.{ts,svelte}",
        "src/hooks.server.ts",
        "src/hooks.client.ts",
        "src/service-worker.{ts,js}",
        "src/app.html",
        "electron/main.ts",
        "electron/preload.ts",
        "electron.vite.config.ts",
        "vite.config.ts",
        "svelte.config.js",
        "eslint.config.js",
        "tools/*.mjs",
        "tests/**/*.{test,spec}.{ts,mjs,js}",
        "tests/**/*.mjs",
        "tests/**/*.ts"
      ],
      "project": [
        "src/**/*.{ts,js,svelte,mjs}",
        "electron/**/*.{ts,js,mjs}",
        "tools/**/*.mjs",
        "tests/**/*.{ts,js,mjs}"
      ]
    }
  }
}
