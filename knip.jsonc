{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Invocation shape: the root `knip` script (package.json) runs the SCOPED,
  // CI-gating check (`--include files,dependencies,unlisted,binaries`) — the
  // only categories with real findings, so `bun run knip` locally and CI
  // agree. The exports/types findings outside that scope are advisory only:
  // every one was hand-traced during the 2026-08 audit as a false positive of
  // the "export keyword is superfluous / used within the same build graph"
  // class. They are intentionally left unsuppressed and ungated — run
  // `bunx knip` with no flags to see them.
  "workspaces": {
    ".": {
      "entry": ["tools/*.mjs"],
      "project": ["tools/**/*.mjs"],
      // packages/open-design-plugin is a Claude plugin (SKILL.md + evals) whose
      // test-fixtures are data trees referenced by string from manifest.yaml
      // files, not by imports — not part of the dead-code surface.
      "ignore": ["packages/open-design-plugin/**"],
      // pdftoppm is an external PDF tool invoked via execCapture by
      // tools/page-background-mechanism.mjs and tools/page-background-repro.mjs —
      // the same documented qpdf/gs/pdf* external-tools exemption as CLAUDE.md's
      // PDF-validation tooling (not an npm dependency to declare).
      "ignoreBinaries": ["pdftoppm"]
    },
    "packages/cli": {
      "entry": [
        "src/cli.ts",
        "src/index.ts",
        "src/render.ts",
        // Browser-side engine bundles: the sole `Bun.build` entrypoints
        // invoked by scripts/build-engine-bundles.mjs (see that script's
        // header) and embedded into the CLI binary via embedded-assets.ts —
        // nothing in src/ imports them, so knip needs them named explicitly
        // or the whole engine reads as dead code.
        "src/engine/viewer/global.ts",
        "src/engine/compiler/agent.ts",
        // Standalone hand-run dev CLI (`bun src/engine/dev-cli.ts build|dev|export …`)
        // for exercising the engine directly, independent of the CLI's own
        // preview server — no in-repo importer by design.
        "src/engine/dev-cli.ts",
        "scripts/*.mjs",
        "src/**/*.test.ts",
        "tests/**/*.test.ts",
        // Check modules are self-registering roots (registerCheck side effect,
        // loaded via checks/register-builtins). Their `export default check` is
        // the per-module test seam (see checks/pdf/structured-check-result.test.ts
        // importing ink-coverage/rasterized-pages/embedded-fonts defaults).
        "src/checks/{asset,heuristic,pdf,source}/*.ts"
      ],
      "project": ["src/**/*.{ts,js,mjs}", "scripts/**/*.mjs", "tests/**/*.{ts,js,mjs}"]
    },
    "packages/editor": {
      // check-browser-purity.test.mjs is the sabotage self-test for the purity
      // checker, invoked via `node` (package script convention mirrors root
      // tools/*.test.mjs) — never imported, so knip needs it named. Added in
      // SFE-P1a; the ./web export surface is declared in package.json exports.
      "entry": ["scripts/*.mjs", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.mjs", "tests/**/*.{ts,mjs}"]
    },
    "packages/desktop": {
      "entry": [
        // PWA-only; no in-repo importer by design (CLAUDE.md §8). P5a deletes
        // this entry along with WebAdapter/web-fs/web-store (plan D10;
        // platform-inventory.md §13/§14).
        "src/service-worker.{ts,js}",
        "tests/**/*.{ts,js,mjs}",
        // Compile-time type assertion gates: never imported, but type-checked by
        // `svelte-check` (they live under src/, inside its tsconfig scope).
        "src/**/*.type-test.ts",
        // The platform seam + typed api surface are documented scaffolding for
        // the remaining PWA phases (CLAUDE.md §8, docs/pwa-webadapter-plan.md,
        // docs/adr/0004-platform-abstraction.md) — intentional export surface,
        // not dead code. Deletion ties (plan D10; platform-inventory.md §14),
        // kept until the tied phase lands — do not remove before then:
        //   web-store.ts                        — P5a deletes (WebAdapter/web-fs/service-worker sibling)
        //   index/contract/dtos/shared-types.ts — P5b narrows; may shrink or fully drop
        //   api.ts                              — P5d deletes (with src/routes/api/**)
        "src/lib/platform/{index,contract,dtos,shared-types,web-store}.ts",
        "src/lib/api.ts"
      ],
      "project": [
        "src/**/*.{ts,js,svelte,mjs}",
        "electron/**/*.{ts,js,mjs}",
        "tools/**/*.mjs",
        "tests/**/*.{ts,js,mjs}"
      ]
    }
  }
}
