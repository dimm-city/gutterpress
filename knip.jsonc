{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Invocation shape: the root `knip` script (package.json) runs the SCOPED,
  // CI-gating check (`--include files,dependencies,unlisted,binaries`) — the
  // only categories with real findings, so `bun run knip` locally and CI
  // agree. The exports/types findings outside that scope are advisory only:
  // every one was hand-traced during the 2026-08 audit as a false positive of
  // the "export keyword is superfluous / used within the same build graph"
  // class. They are intentionally left unsuppressed and ungated — run
  // `bunx knip` with no flags to see them.
  "workspaces": {
    ".": {
      "entry": ["tools/*.mjs"],
      "project": ["tools/**/*.mjs"],
      // packages/open-design-plugin is a Claude plugin (SKILL.md + evals) whose
      // test-fixtures are data trees referenced by string from manifest.yaml
      // files, not by imports — not part of the dead-code surface.
      "ignore": [
        "packages/open-design-plugin/**",
        // packages/vscode-markdown-editor is a vendored third-party artifact
        // (see its NOTICE/PATCHES.md): byte-pinned by scripts/verify-vendored.mjs
        // checksums, manifest mirrored from upstream verbatim (D5). Knip's
        // dead-code/dependency analysis is the wrong instrument for it — same
        // treatment as node_modules content. SFE-P1b2.
        "packages/vscode-markdown-editor/**"
      ],
      // pdftoppm is an external PDF tool invoked via execCapture by
      // tools/page-background-mechanism.mjs and tools/page-background-repro.mjs —
      // the same documented qpdf/gs/pdf* external-tools exemption as CLAUDE.md's
      // PDF-validation tooling (not an npm dependency to declare).
      "ignoreBinaries": ["pdftoppm"]
    },
    "packages/cli": {
      "entry": [
        "src/cli.ts",
        "src/index.ts",
        "src/render.ts",
        // gutterpress/plugins (D11, SFE-P3e): a subpath dist entrypoint like
        // render.ts above, not imported by anything else in this package —
        // consumed externally via package.json's "./plugins" export.
        "src/plugins.ts",
        // Browser-side engine bundles: the sole `Bun.build` entrypoints
        // invoked by scripts/build-engine-bundles.mjs (see that script's
        // header) and embedded into the CLI binary via embedded-assets.ts —
        // nothing in src/ imports them, so knip needs them named explicitly
        // or the whole engine reads as dead code.
        "src/engine/viewer/global.ts",
        "src/engine/compiler/agent.ts",
        // Standalone hand-run dev CLI (`bun src/engine/dev-cli.ts build|dev|export …`)
        // for exercising the engine directly, independent of the CLI's own
        // preview server — no in-repo importer by design.
        "src/engine/dev-cli.ts",
        "scripts/*.mjs",
        "src/**/*.test.ts",
        "tests/**/*.test.ts",
        // Check modules are self-registering roots (registerCheck side effect,
        // loaded via checks/register-builtins). Their `export default check` is
        // the per-module test seam (see checks/pdf/structured-check-result.test.ts
        // importing ink-coverage/rasterized-pages/embedded-fonts defaults).
        "src/checks/{asset,heuristic,pdf,source}/*.ts"
      ],
      "project": ["src/**/*.{ts,js,mjs}", "scripts/**/*.mjs", "tests/**/*.{ts,js,mjs}"]
    },
    "packages/editor": {
      // check-browser-purity.test.mjs is the sabotage self-test for the purity
      // checker, invoked via `node` (package script convention mirrors root
      // tools/*.test.mjs) — never imported, so knip needs it named. Added in
      // SFE-P1a; the ./web export surface is declared in package.json exports.
      //
      // `.btest.ts` (SFE-P1b): the real-Chromium suite suffix, deliberately
      // outside Bun's default `*.test.ts` glob so `bun run test` stays fast
      // and hermetic — run only by `bun run test:browser`, and never
      // imported by anything else in the tree. Without this entry knip's
      // script parser only resolves the FIRST command in test:browser's
      // `&&` chain, so every *.btest.ts and its support/ tree reads as dead
      // code. Name the suffix explicitly here rather than relying on that
      // parsing accident.
      // tests/**/support/entry.ts (SFE-P2b): browser-bundle entry points the
      // harness resolves BY PATH STRING (bundle.ts bun-builds them at test
      // runtime), so ones not also type-imported by a btest are invisible to
      // knip's import graph. They are genuine entries, not dead code.
      "entry": ["scripts/*.mjs", "tests/**/*.test.ts", "tests/**/*.btest.ts", "tests/**/support/*entry.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.mjs", "tests/**/*.{ts,mjs}"]
    },
    "packages/vscode-extension": {
      // SFE-P3c: this package gets its first real build step
      // (scripts/build.mjs) and test suites this run. `entry` names
      // src/extension.ts (the package.json "main" -> dist/extension.js
      // source, loaded by the real VS Code extension host, not imported by
      // anything else in this repo) and every test file explicitly.
      // scripts/build.mjs is NOT listed here (knip flags that as a
      // redundant entry pattern): it is already a package.json SCRIPT
      // command ("build"), which knip's own npm-script scanning already
      // treats as a reachable root.
      //
      // Reconciliation addendum (integration lane D) widened this entry
      // list, mirroring packages/editor's own precedent exactly (see that
      // workspace's own comment for the identical reasoning applied here):
      //   - src/webview/index.ts — scripts/build.mjs's OWN webview bundle
      //     entry point (`target: "browser"`), resolved by path string at
      //     build time, not imported by src/extension.ts or anything else
      //     in this package's own import graph.
      //   - tests/**/*.btest.ts — the real-Chromium suite suffix,
      //     deliberately outside Bun's default `*.test.ts` glob so `bun run
      //     test` stays fast and hermetic; run only by `bun run
      //     test:browser`'s explicit per-file invocations, never imported
      //     by anything else in the tree.
      //   - tests/**/support/*.ts — browser-bundle entry points
      //     (tests/webview/support/{entry,csp-entry}.ts) the harness
      //     resolves BY PATH STRING, plus their own support modules
      //     (fake-extension-host.ts) that only those two import — genuine
      //     entries/reachable-from-entries, not dead code.
      //
      // Repair round 2: dropped the tests/host-fidelity/run-in-host.js
      // entry that used to sit alongside these — its whole launcher
      // scaffold (launch.mjs, run-in-host.js, the "test:host-fidelity"
      // script that made it reachable) was deleted in repair round 1
      // (docs/plans/source-first-editor/runs/SFE-P3c.md, "Host-fidelity
      // deviation"), and the entry pattern outlived it, so knip flagged it
      // as matching nothing.
      "entry": [
        "src/extension.ts",
        "src/webview/index.ts",
        "tests/**/*.test.ts",
        "tests/**/*.btest.ts",
        "tests/**/support/*.ts"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.mjs", "tests/**/*.{ts,js,mjs}"],
      // tests/project/fixtures/plugin-project/plugins/highlight.js is a
      // real, on-disk project-plugin fixture `projection.test.ts` loads
      // dynamically (gutterpress/plugins' loadPluginsWithCss resolves it
      // from manifest.yaml's own `plugins:` list, a STRING path, not a JS
      // import) — the exact same "referenced by string, not by imports"
      // shape the root workspace's own `ignore` already documents for
      // packages/open-design-plugin's fixture trees; not part of the
      // dead-code surface either.
      "ignore": ["tests/project/fixtures/**"]
    },
    "packages/desktop": {
      "entry": [
        "tests/**/*.{ts,js,mjs}",
        // Compile-time type assertion gates: never imported, but type-checked by
        // `svelte-check` (they live under src/, inside its tsconfig scope).
        "src/**/*.type-test.ts",
        // The platform seam + typed api surface are documented scaffolding for
        // the desktop platform work still in flight (plan D10/D11;
        // platform-inventory.md §14) — intentional export surface, not dead
        // code. `src/service-worker.{ts,js}` and `web-store.ts` dropped out of
        // this list in P5a with the PWA/WebAdapter code they protected (plan
        // D10). What remains, and its own deletion tie, kept until the tied
        // phase lands — do not remove before then:
        //   index/contract/dtos/shared-types.ts — P5b narrows; may shrink or fully drop
        //   api.ts                              — P5d deletes (with src/routes/api/**)
        "src/lib/platform/{index,contract,dtos,shared-types}.ts",
        "src/lib/api.ts"
      ],
      "project": [
        "src/**/*.{ts,js,svelte,mjs}",
        "electron/**/*.{ts,js,mjs}",
        "tools/**/*.mjs",
        "tests/**/*.{ts,js,mjs}"
      ]
    },
  }
}
