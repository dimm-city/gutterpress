{
  "name": "gutterpress",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "cli": "bun --cwd packages/cli src/cli.ts",
    "build": "cd packages/cli && bun run build",
    "test": "bun --filter '*' test",
    "typecheck": "bun --filter '*' typecheck",
    "desktop:dev": "bun --cwd packages/desktop dev",
    "desktop:electron": "bun --cwd packages/desktop electron:dev"
  },
  "devDependencies": {
    "playwright-core": "^1.60.0"
  },
  "overrides": {
    "ws": "^8.21.0",
    "undici": "^7.28.0",
    "form-data": "^4.0.6",
    "tmp": "^0.2.6",
    "shell-quote": "^1.8.5",
    "cookie": "^0.7.2",
    "tar": "^7.5.20",
    "axios": "^1.18.0",
    "postcss": "^8.5.18",
    "brace-expansion": "^5.0.8"
  }
}
