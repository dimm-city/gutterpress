{
  "name": "gutterpress",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "cli": "bun --cwd packages/cli src/cli.ts",
    "build": "cd packages/cli && bun run build",
    "test": "bun --filter '*' test",
    "typecheck": "bun --filter '*' typecheck",
    "desktop:dev": "bun --cwd packages/desktop dev",
    "desktop:electron": "bun --cwd packages/desktop electron:dev"
  },
  "devDependencies": {
    "playwright-core": "^1.60.0"
  },
  "overrides": {
    "ws": "^8.21.0",
    "undici": "^7.30.0",
    "form-data": "^4.0.6",
    "tmp": "^0.2.6",
    "shell-quote": "^1.8.5",
    "cookie": "^0.7.2",
    "tar": "^7.5.22",
    "axios": "^1.20.0",
    "postcss": "^8.5.18",
    "brace-expansion": "^5.0.12",
    "@xmldom/xmldom": "^0.8.15",
    "baseline-browser-mapping": "^2.11.27",
    "browserslist": "^4.29.3",
    "devalue": "^5.9.4",
    "fast-uri": "^3.1.8",
    "http-cache-semantics": "^4.3.0",
    "joi": "^18.2.9",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.19",
    "postcss-selector-parser": "^7.1.6",
    "katex": "^0.18.2",
    "source-map-js": "^1.2.2"
  }
}
