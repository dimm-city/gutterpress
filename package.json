{
  "name": "@itlackey/pagedmd",
  "version": "2.0.0",
  "description": "Markdown-to-PDF converter for professional print layout using Chromium and Paged.js",
  "author": "itlackey",
  "license": "CC-BY-4.0",
  "keywords": [
    "markdown",
    "pdf",
    "print",
    "pagedjs",
    "chromium",
    "book",
    "publishing",
    "ttrpg"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/itlackey/pagedmd.git"
  },
  "homepage": "https://github.com/itlackey/pagedmd#readme",
  "bugs": {
    "url": "https://github.com/itlackey/pagedmd/issues"
  },
  "module": "src/index.ts",
  "type": "module",
  "bin": {
    "pagedmd": "./src/cli.ts"
  },
  "files": [
    "src/",
    "profiles/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint:css": "bun src/cli.ts lint",
    "convert:md": "bun src/cli.ts convert",
    "copy:assets": "bun src/cli.ts assets",
    "build:pdf": "bun src/cli.ts build",
    "validate:pdf": "bun src/cli.ts validate",
    "preview": "bun src/cli.ts preview",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage --coverage-reporter=text"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "glob": "^13.0.0",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "citty": "^0.2.0",
    "markdown-it": "^14.1.0",
    "markdown-it-attrs": "^4.3.0",
    "markdown-it-container": "^4.0.0",
    "pagedjs": "^0.4.3",
    "playwright": "^1.58.0",
    "vite": "^7.2.1",
    "yaml": "^2.8.2"
  }
}
