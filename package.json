{
  "name": "print-md-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "cli": "bun --cwd packages/cli src/cli.ts",
    "build": "cd packages/cli && bun run build",
    "test": "bun --filter '*' test",
    "typecheck": "bun --filter '*' typecheck",
    "viewer:dev": "bun --cwd packages/viewer dev",
    "viewer:electron": "bun --cwd packages/viewer electron:dev"
  }
}
