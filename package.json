{
  "name": "print-md-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "cli": "bun --cwd packages/cli src/cli.ts",
    "build": "cd packages/cli && bun run build",
    "test": "bun --filter '*' test",
    "typecheck": "bun --filter '*' typecheck",
    "viewer:dev": "bun --cwd packages/viewer dev",
    "viewer:electron": "bun --cwd packages/viewer electron:dev"
  },
  "overrides": {
    "ws": "^8.21.0",
    "undici": "^7.28.0",
    "form-data": "^4.0.6",
    "tmp": "^0.2.6",
    "shell-quote": "^1.8.5",
    "cookie": "^0.7.2",
    "tar": "^7.5.20",
    "axios": "^1.18.0",
    "postcss": "^8.5.18",
    "brace-expansion": "^5.0.8"
  },
  "dependencies": {
    "electron-builder-squirrel-windows": "^26.15.3",
    "js-yaml": "^5.2.2",
    "launch-editor": "^2.14.1",
    "markdown-it": "^14.3.0",
    "tar": "^7.5.20",
    "undici": "^7.28.0",
    "vite": "^8.1.4"
  }
}